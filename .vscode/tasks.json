{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blook Berry: Start server",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "blook-maker",
        "pattern": { "regexp": "^never-matches$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting Blook Berry",
          "endsPattern": "^Running at"
        }
      }
    },
    {
      "label": "Blook Berry: Preview in VS Code",
      "type": "shell",
      "command": "echo Preview open ${input:openPreview}",
      "dependsOn": "Blook Berry: Start server",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openPreview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:5180"
    }
  ]
}
